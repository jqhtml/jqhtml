<!--
TBody_Test - Test how tbody tags are rendered in compiled output
-->
<Define:TBody_Test>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                Hello
            </thead>
            <tbody $redrawable $id="datagrid_table_body">
                <tr>
                    <td>Greetings</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div $redrawable $id="random_content" class="mt-3">
        <p>This is some random content below the table</p>
        <span>More random stuff here</span>
    </div>
</Define:TBody_Test>
