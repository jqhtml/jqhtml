# JQHTML public repository .gitignore
# Installed by release_scripts/sync_release.sh - edit it there, not in the release repo.
#
# A clone must stay buildable:  npm install && npm run build
# Everything needed for that (sources, configs, the root package-lock.json, scripts/,
# build.sh) is tracked; everything that command regenerates is ignored here.

# --- dependencies (restored by npm install from the tracked root package-lock.json) ---
node_modules/

# --- build outputs (regenerated by npm run build) ---
dist/
out/
*.tsbuildinfo
*.vsix

# --- tool caches ---
.nx/
.cache/
.eslintcache

# --- test / coverage output ---
*.log
test-results/
playwright-report/
coverage/
.nyc_output/

# --- local environment, editor and OS files ---
.env
.env.*
.npmrc
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.bak
*.backup
*.tmp

# --- agent-local files (the tracked CLAUDE.md is the public agent quickstart) ---
.claude/
CLAUDE.local.md

# --- second net for internal-only material (primary filter: excludes_jqhtml.txt) ---
/docs/internal/
/docs/dev_notes/
/docs/archive/
/docs/research/
/archive/
/aux/
/testme/
/release/
.beads/
