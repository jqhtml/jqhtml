{
  "name": "@jqhtml/monorepo",
  "version": "2.4.1",
  "description": "JQHTML - A jQuery-first Component Framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "./build.sh",
    "build:clean": "./build.sh --clean",
    "build:verbose": "./build.sh --verbose",
    "build:core": "cd packages/core && npm run build",
    "build:parser": "cd packages/parser && npm run build",
    "watch": "npm run watch:core",
    "watch:core": "cd packages/core && npm run watch",
    "test": "cd tests && ./run-all-tests.sh",
    "test:core": "cd packages/core && npm test",
    "test:parser": "cd packages/parser && npm test",
    "validate:docs": "node scripts/validate_doc_examples.js",
    "test:all": "./run-all-suites.sh",
    "test:regression": "cd packages/parser && npm run test:regression",
    "test:ssr": "cd packages/ssr && npm test",
    "test:sourcemap": "cd packages/parser && npm run validate:sourcemap"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/node": "^20.10.0",
    "source-map": "^0.7.6",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "chalk": "^5.6.2",
    "concat-with-sourcemaps": "^1.1.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.56.1",
    "puppeteer": "^24.10.2"
  }
}
