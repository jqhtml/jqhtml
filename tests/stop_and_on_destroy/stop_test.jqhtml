<!--
Stop_Test - Component that starts interval in on_ready, cleans up in on_stop

LIFECYCLE:
  on_ready()   - Start interval
  on_stop()    - Clear interval
-->
<Define:Stop_Test>
  <div class="card">
    <h3>stop() and on_stop() Test</h3>
    <p>Component is running. Check console for interval messages.</p>
    <p id="results"></p>
  </div>
</Define:Stop_Test>
