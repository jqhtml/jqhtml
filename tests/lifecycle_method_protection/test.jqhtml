<Define:Test_Lifecycle_Method_Protection>
  <div>
    <h1>Lifecycle Method Protection Test</h1>
    <p>Tests that lifecycle methods cannot be called manually but still execute correctly via framework.</p>

    <h2>Protection Tests (Should Block Manual Calls)</h2>
    <Manual_On_Create_Call $sid="t1" />
    <Manual_On_Load_Call $sid="t2" />
    <Manual_On_Ready_Call $sid="t3" />
    <Manual_On_Render_Call $sid="t4" />
    <Manual_On_Stop_Call $sid="t5" />

    <h2>Lifecycle Execution Tests (Framework Calls Should Work)</h2>
    <Lifecycle_Executes_Correctly $sid="t6" />

    <h2>Parent Calling Child Lifecycle (Should Block)</h2>
    <Parent_Calls_Child_Lifecycle $sid="t7" />
  </div>
</Define:Test_Lifecycle_Method_Protection>
