<Define:Shb_Class_Grid>
  <Slot:header>
    <button $sid="hdr_btn" @click=this.on_header_click>header</button>
    <Shb_Marker $sid="hdr_marker" />
  </Slot:header>
  <Slot:row>
    <li><button class="row-btn" @click=this.on_row_click><%= row.name %></button></li>
  </Slot:row>
</Define:Shb_Class_Grid>
