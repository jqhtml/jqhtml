<!--
Test case: Valid attribute interpolation (with quotes)
This should compile successfully
-->
<Define:Test_Valid_Interpolation>
  <div class="mb-3">
    <Form_Field $name="role_id" $label="Role" $required=true>
      <Select_Input $options="<%= JSON.stringify([
        {value: 3, label: 'Member'},
        {value: 2, label: 'Admin'},
        {value: 1, label: 'Owner'},
        {value: 4, label: 'Viewer'}
      ]) %>" />
    </Form_Field>
  </div>
</Define:Test_Valid_Interpolation>
