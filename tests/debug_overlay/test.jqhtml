<Define:Test_Debug_Overlay>
  <div>
    <h1>Component debug overlay</h1>
    <Dbg_Outer $sid="outer" $id=7 $title="Users" $records=this.state.records $on_pick=this.on_pick>
      <Dbg_Inner $sid="inner" $id=42 $flag=true>
        <button $sid="btn" @click=this.on_btn_click>click me</button>
      </Dbg_Inner>
    </Dbg_Outer>
    <div $sid="mount"></div>
  </div>
</Define:Test_Debug_Overlay>
