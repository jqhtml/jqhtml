<%--
Test_Loaded_Without_On_Load - on_loaded() and 'loaded' run for a component with no
on_load(), at the point where on_load() would have completed: boot, reload(), refresh()
and load(). Suppressed by _load_only/_load_render_only and on a stopped component.
--%>
<Define:Test_Loaded_Without_On_Load>
  <h1>on_loaded() and 'loaded' without on_load()</h1>
  <Nl_Probe $sid="probe" $name="main" />
  <div $sid="scratch"></div>
</Define:Test_Loaded_Without_On_Load>
