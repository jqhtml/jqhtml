<Define:Counter_Widget class="super_classy">

    <div class="Counter_Widget">
        <h4 $sid="title" class="counter-title"><%= this.data.title || 'Counter Widget' %></h4>
        <div class="counter-display">
            <button $sid="decrement" class="btn btn-danger counter-btn" @click=this.decrement>-</button>
            <button $sid="increment" class="btn btn-success counter-btn" @click=this.increment>+</button>
        </div>
        <!-- barfoo on line 10 -->
        <div><%= barfoo() && "test" || "nothing" %></div>
        <div class="counter-controls">
            <button $sid="reset" class="btn btn-sm btn-secondary" @click=this.reset>Reset</button>
            <button $sid="random" class="btn btn-sm btn-info" @click=this.random>Random</button>
        </div>
    </div>

</Define:Counter_Widget>