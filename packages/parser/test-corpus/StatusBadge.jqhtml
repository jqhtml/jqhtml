<Define:StatusBadge as="span">
  <% 
    // Get status from args (supports both status and data-status)
    const status = this.args.status || this.args['data-status'] || 'offline';
  %>
  <% if (status === 'online'): %>
    <span class="status-indicator online">●</span> Online
  <% else if (status === 'busy'): %>
    <span class="status-indicator busy">●</span> Busy
  <% else: %>
    <span class="status-indicator offline">●</span> Offline
  <% endif; %>
</Define:StatusBadge>