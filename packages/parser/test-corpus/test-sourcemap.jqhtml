<Define:TestComponent>
  <div class="container">
    <h1>Test Component</h1>

    <%-- This is a multi-line comment
         that spans several lines
         to test line preservation
         in the sourcemap generation
         with proper offset handling --%>

    <% function testFunction() { %>
      <p>Line 12: Inside test function</p>
    <% } %>

    <% testFunction(); %>

    <button @click=this.handleClick>
      Click Me (Line 18)
    </button>

    <%
      // Line 22
      function handleClick() {
        console.log('Button clicked at line 24');
        barfoo(); // Line 25 - this should error
      }
    %>
  </div>
</Define:TestComponent>
