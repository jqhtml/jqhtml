<Define:TestComponent>
  <!-- Correct: unquoted values as variable/method references -->
  <button @click=this.handleClick>Good - Method reference</button>
  <button @click=handleClick>Good - Simple method name</button>
  <div $data=this.data.user>Good - Data reference</div>
  <div $active=isActive>Good - Variable reference</div>

  <!-- Correct: quoted values as string literals on $ attributes -->
  <div $foo="bar">String literal "bar"</div>

  <!-- Should throw error: quoted values on an event attribute pass a string,
       not the function reference @ requires -->
  <!-- <button @click="handleClick">BAD - String not function</button> -->

  <!-- Should throw error: function calls not allowed -->
  <!-- <button @click=this.handleClick()>BAD - Function call</button> -->
  <!-- <button @click=doSomething()>BAD - Function call</button> -->

  <!-- Complex member expressions -->
  <div $config=this.settings.user.preferences>Good - Deep property access</div>

  <!-- Mixed quoted and unquoted -->
  <Component
    title="Static String"
    @onUpdate=this.handleUpdate
    $data=userData
    class="css-class"
  />
</Define:TestComponent>