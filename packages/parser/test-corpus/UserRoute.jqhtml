<Define:UserRoute>
    <div class="route-content">
        <h2>User Profile</h2>
        <% if (this.data.user) { %>
            <div class="user-profile">
                <div class="user-avatar"><%= this.data.user.avatar %></div>
                <div class="user-info">
                    <h3><%= this.data.user.name %></h3>
                    <p>@<%= this.data.user.username %> · <StatusBadge $status="<%= this.data.user.status || 'offline' %>"></StatusBadge></p>
                    <p><%= this.data.user.bio %></p>
                </div>
            </div>
        <% } else { %>
            <div class="loading">Loading user profile...</div>
        <% } %>
    </div>
</Define:UserRoute>